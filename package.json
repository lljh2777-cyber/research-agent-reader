{
	"name": "research-agent-reader",
	"version": "0.29.0",
  "private": true,
  "description": "Desktop research reader and optional local-agent dashboard for Obsidian",
  "author": "Liao Li",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
		"format:normalize": "node scripts/normalize-text.mjs",
    "typecheck": "tsc --noEmit",
		"test": "node tests/run_dashboard_tests.js",
		"verify": "pnpm typecheck && pnpm build && pnpm test",
		"release:check": "node scripts/release-audit.mjs",
		"test-vault:prepare": "node scripts/prepare-test-vault.mjs",
		"verify:public": "pnpm verify && pnpm release:check && pnpm test-vault:prepare",
		"version": "node scripts/sync-version.mjs",
		"obsidian:check": "node scripts/obsidian-cli.mjs check",
		"obsidian:reload": "node scripts/obsidian-cli.mjs reload",
		"obsidian:qa": "node scripts/obsidian-cli.mjs qa",
		"verify:obsidian": "pnpm verify && node scripts/obsidian-cli.mjs qa"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
